    column ID { dataType: int64; sourceColumn: "ID"; }
    column BRANCH_CODE { dataType: string; sourceColumn: "BRANCH_CODE"; }
    column CELLULAR_PHONE { dataType: string; sourceColumn: "CELLULAR_PHONE"; }
