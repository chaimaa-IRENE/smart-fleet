    column PASSWORD_DIGEST { dataType: string; sourceColumn: "PASSWORD_DIGEST"; }
    column PASSWORD_EXPIRY_DATE { dataType: dateTime; sourceColumn: "PASSWORD_EXPIRY_DATE"; }
    column PASSWORD_RESET_TOKEN { dataType: string; sourceColumn: "PASSWORD_RESET_TOKEN"; }
    column PASSWORD_RESET_TOKEN_EXPIRES_AT { dataType: dateTime; sourceColumn: "PASSWORD_RESET_TOKEN_EXPIRES_AT"; }
    column PERSON_CODE { dataType: string; sourceColumn: "PERSON_CODE"; }
    column PHONE { dataType: string; sourceColumn: "PHONE"; }
    column PROFILE_CODE { dataType: string; sourceColumn: "PROFILE_CODE"; }
    column ROLE { dataType: string; sourceColumn: "ROLE"; }
    column ROLE_BRANCH { dataType: string; sourceColumn: "ROLE_BRANCH"; }
    column ROLE_CODE { dataType: string; sourceColumn: "ROLE_CODE"; }
    column ROLE_DEPARTEMENT { dataType: string; sourceColumn: "ROLE_DEPARTEMENT"; }
    column STATUS { dataType: string; sourceColumn: "STATUS"; }
    column USERNAME { dataType: string; sourceColumn: "USERNAME"; }
    column VALIDATION_CODE { dataType: string; sourceColumn: "VALIDATION_CODE"; }
    column VALIDATION_CODE_EXPIRES_AT { dataType: dateTime; sourceColumn: "VALIDATION_CODE_EXPIRES_AT"; }
    column VILLE { dataType: string; sourceColumn: "VILLE"; }

    measure 'Nb Utilisateurs' = COUNTROWS('Utilisateurs')
      formatString: "#,##0";

    measure 'Chauffeurs' = CALCULATE(COUNTROWS('Utilisateurs'), 'Utilisateurs'[ROLE] = "CHAUFFEUR")
      formatString: "#,##0";

    partition 'users' {
      source =
        let
          Source = Csv.Document(File.Contents("C:/Users/moutaoch/Downloads/smart-fleet-master/powerbi_rs/dataset/users.csv"), [Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
          Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
          Typed = Table.TransformColumnTypes(Promoted, {
            {"ID", Int64.Type}, {"BRANCH_CODE", type text}, {"CELLULAR_PHONE", type text},
            {"CREATED_BY_ROLE_ID", Int64.Type}, {"CREATION_DATE", type datetime},
            {"EMAIL", type text}, {"EMAIL_VALIDATED", type logical},
            {"FACE_DESCRIPTOR", type text}, {"FACE_REGISTERED", type logical},
            {"FIRSTNAME", type text}, {"HOLD_PERSON", type text}, {"HOLD_REASON", type text},
            {"HOLD_RELATED_ROLE", type text}, {"HOLD_ROLE_BRANCH", type text},
            {"LAST_CONNECTION_DATE", type datetime}, {"LAST_UPDATE", type datetime},
            {"NAME", type text}, {"PASSWORD", type text}, {"PASSWORD_DIGEST", type text},
            {"PASSWORD_EXPIRY_DATE", type datetime}, {"PASSWORD_RESET_TOKEN", type text},
            {"PASSWORD_RESET_TOKEN_EXPIRES_AT", type datetime}, {"PERSON_CODE", type text},
            {"PHONE", type text}, {"PROFILE_CODE", type text}, {"ROLE", type text},
            {"ROLE_BRANCH", type text}, {"ROLE_CODE", type text}, {"ROLE_DEPARTEMENT", type text},
            {"STATUS", type text}, {"USERNAME", type text}, {"VALIDATION_CODE", type text},
            {"VALIDATION_CODE_EXPIRES_AT", type datetime}, {"VILLE", type text}
          })
        in
          Typed;
      mode: Import;
    }
  }

  // =====================================================================
  // RELATIONS (1:*) — clé étrangère exacte VEHICULE_ID / CHAUFFEUR_ID
  // =====================================================================
  relationship r_vehicules_declarations {
    from: Vehicules.ID;
    to: Declarations.VEHICULE_ID;
    crossFilteringBehavior: oneDirection;
  }

  relationship r_vehicules_checklists {
    from: Vehicules.ID;
    to: Checklists.VEHICULE_ID;
    crossFilteringBehavior: oneDirection;
  }

  relationship r_vehicules_documents {
    from: Vehicules.ID;
    to: DocumentsVehicule.VEHICULE_ID;
    crossFilteringBehavior: oneDirection;
  }

  relationship r_vehicules_anomalies {
    from: Vehicules.ID;
    to: AnomaliesCheckup.VEHICULE_ID;
    crossFilteringBehavior: oneDirection;
  }

  relationship r_vehicules_blocages {
    from: Vehicules.ID;
    to: VehicleBlocking.VEHICULE_ID;
    crossFilteringBehavior: oneDirection;
  }

  relationship r_vehicules_departs {
    from: Vehicules.ID;
    to: DepartHistorique.VEHICULE_ID;
    crossFilteringBehavior: oneDirection;
  }

  relationship r_vehicules_tournees {
    from: Vehicules.ID;
    to: Tournees.VEHICULE_ID;
    crossFilteringBehavior: oneDirection;
  }

  relationship r_users_declarations {
    from: Utilisateurs.ID;
    to: Declarations.CHAUFFEUR_ID;
    crossFilteringBehavior: oneDirection;
  }

  relationship r_users_checklists {
    from: Utilisateurs.ID;
    to: Checklists.CHAUFFEUR_ID;
    crossFilteringBehavior: oneDirection;
  }

  relationship r_users_anomalies {
    from: Utilisateurs.ID;
    to: AnomaliesCheckup.CHAUFFEUR_ID;
    crossFilteringBehavior: oneDirection;
  }
}
